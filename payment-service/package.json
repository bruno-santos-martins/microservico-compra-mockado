{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npx kill-port 3333",
    "predev:local": "docker compose -f docker-compose.db.yml up -d --wait && npx kill-port 3333",
    "dev": "npx ts-node-dev --respawn --exit-child --transpile-only --debounce 400 --ignore-watch node_modules --ignore-watch dist app/main.ts",
    "dev:local": "npx ts-node-dev --respawn --exit-child --transpile-only --debounce 400 --ignore-watch node_modules --ignore-watch dist app/main.ts",
    "dev:bootstrap": "npm install --include=dev --no-audit && npx prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/main.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "payment-service": "file:",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "prisma": "^6.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
